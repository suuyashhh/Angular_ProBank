{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "Angular_ProBank": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "_redirects",
                "input": "src/assets",
                "output": "/"
              }
            ],
            "styles": [
              "src/assets/vendor/css/core.css",
              "src/styles.css",
              "src/assets/vendor/fonts/remixicon/remixicon.css",
              "src/assets/vendor/libs/node-waves/node-waves.css",
              "src/assets/vendor/css/theme-default.css",
              "src/assets/css/demo.css",
              "src/assets/vendor/css/pages/page-auth.css",
              "src/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css"
            ],
            "scripts": [
              "src/assets/vendor/libs/jquery/jquery.js",
              "src/assets/vendor/libs/popper/popper.js",
              "src/assets/vendor/js/helpers.js",
              "src/assets/js/config.js",
              "src/assets/vendor/js/bootstrap.js",
              "src/assets/vendor/js/menu.js",
              "src/assets/js/main.js",
              "src/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js",
              "src/assets/js/mobileview.js"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Angular_ProBank:build:production"
            },
            "development": {
              "buildTarget": "Angular_ProBank:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          }
        }
      }
    }
  }
}
